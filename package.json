{
    "name": "symphony",
    "private": true,
    "version": "1.1.5",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "package-app": "node scripts/package-app.mjs",
        "package-app:windows": ".\\scripts\\package-app-windows.bat",
        "package-app:mac": "sh ./scripts/package-app-mac.sh",
        "build:react": "vite build",
        "build:backend": "pyinstaller --clean --noconfirm symphony-backend.spec",
        "stage:backend": "node scripts/stage-backend-sidecar.mjs",
        "verify:artifacts": "node scripts/verify-build-artifacts.mjs",
        "build:icons": "node ./scripts/generate-icons.mjs",
        "tauri": "tauri",
        "tauri:build": "node scripts/tauri-build-installer.mjs",
        "lint": "eslint",
        "preview": "vite preview",
        "vite": "vite",
        "py": "python main.py",
        "dev:py": "concurrently -k \"vite\" \"python main.py\""
    },
    "dependencies": {
        "lucide-react": "^0.563.0",
        "path-browserify": "^1.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@tauri-apps/cli": "^2.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "concurrently": "^9.2.0",
        "eslint": "^9.9.0",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^15.9.0",
        "png2icons": "^2.0.1",
        "sharp": "^0.34.5",
        "vite": "^5.4.11"
    }
}
